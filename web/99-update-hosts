!/bin/bash

INTERFACE=$1
ACTION=$2
DOMAIN="ffstroubleshootingsystem.com www.ffstroubleshootingsystem.com"

if [ "$INTERFACE" = "wlo1" ] && [ "$ACTION" = "up" ] || [ "$ACTION" = "dhcp4-change" ]; }; then

	IP=$(ip -4 -o addr show wlo1 | awk '{print $4}' | cut -d/ -f1)

	if [ -n "$IP" ]; then

		sed -i "/[[:space:]]$DOMAIN\b/d" /etc/hosts

		echo "$IP $DOMAIN" >> /etc/hosts

	fi
fi
